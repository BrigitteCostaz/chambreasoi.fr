# ============================================
# Root-level ignores for monorepo
# ============================================

# Dependencies
**/node_modules/
**/.pnp
**/.pnp.js
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml

# Build outputs
**/dist/
**/build/
**/.astro/
**/.sanity/

# Environment variables
**/.env
**/.env.local
**/.env.*.local
**/.env.production

# Logs
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Testing
**/coverage/

# IDE/Editor files
.vscode/
.idea/
**/*.swp
**/*.swo
**/*~

# OS files
.DS_Store
**/.DS_Store
Thumbs.db
**/*.pem

# TypeScript
**/*.tsbuildinfo

# Temporary files
**/tmp/
**/temp/
**/.cache/

# Local-only files
**/*.local
