# Same project as studio-chambreasoi.fr/.env (SANITY_STUDIO_PROJECT_ID).
PUBLIC_SANITY_PROJECT_ID=

# In local dev, astro.config.mjs forces dataset "production" and syncs PUBLIC_SANITY_DATASET.
# For production builds, set explicitly if not using the default:
# PUBLIC_SANITY_DATASET=production

# IndexNow (optional — Cloudflare Worker secret in production)
# Generate: openssl rand -hex 16
# Serves verification file at https://chambreasoi.fr/{INDEXNOW_KEY}.txt
# INDEXNOW_KEY=

# Sanity webhook revalidation (production Worker secrets)
# SANITY_WEBHOOK_SECRET=
# CF_ZONE_ID=   (Zone ID for chambreasoi.fr — Overview sidebar, not Account ID)
# CF_API_TOKEN= (API Token with Zone → Purge on chambreasoi.fr — not Global API Key)
