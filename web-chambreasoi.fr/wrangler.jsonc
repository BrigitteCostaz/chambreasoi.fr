{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chambreasoi-web",
  //"main": "./dist/_worker.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_SANITY_PROJECT_ID": "vq8mnl17",
    "PUBLIC_SANITY_DATASET": "production",
    "SANITY_PROJECT_ID": "vq8mnl17",
    "SANITY_DATASET": "production"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "01c4610c325f41059e0d0e32b6b48d15",
      "preview_id": "01c4610c325f41059e0d0e32b6b48d15"
    }
  ]
}
