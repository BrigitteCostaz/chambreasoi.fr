{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chambreasoi",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": { "enabled": true },
}
