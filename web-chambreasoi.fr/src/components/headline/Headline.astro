---
import { getHeadlineContent } from "@lib/sanity";

const headline = await getHeadlineContent();
const h = {
  headLineText:
    headline?.headLineText ??
    " Dans une maison individuelle de plain-pied, au calme et dans un environnement de verdure. Vous serez  attendu.e.s et accueilli.e.s par au moins une personne qui aura à coeur de rendre votre séjour chez nous agréable.",
};
---

<div class="overflow-x-clip relative">
  <!-- Grid overlay -->
  <div class="pointer-events-none absolute inset-0 translate-x-[0.15rem]">
    <!-- Mobile grid -->
    <div class="grid size-full grid-cols-2 gap-4 lg:hidden">
      <div
        class="relative h-full after:absolute after:inset-y-0 after:right-0 after:translate-x-full after:w-1 after:bg-txtPri after:content-['']"
      >
      </div>
      <div></div>
    </div>

    <!-- Desktop grid -->
    <div class="hidden lg:grid size-full grid-cols-5 gap-4">
      <div
        class="relative h-full after:absolute after:inset-y-0 after:right-0 after:translate-x-full after:w-1px after:bg-txtPri/20 after:content-['']"
      >
      </div>
      <div
        class="relative h-full after:absolute after:inset-y-0 after:right-0 after:translate-x-full after:w-1px after:bg-txtPri/20 after:content-['']"
      >
      </div>
      <div
        class="relative h-full after:absolute after:inset-y-0 after:right-0 after:translate-x-full after:w-1px after:bg-txtPri/20 after:content-['']"
      >
      </div>
      <div
        class="relative h-full after:absolute after:inset-y-0 after:right-0 after:translate-x-full after:w-1px after:bg-txtPri/20 after:content-['']"
      >
      </div>
      <div></div>
    </div>
  </div>

  <!-- Content -->
  <section
    class="relative isolate size-full border-x transition-colors duration-1000 ease-out lg:border-x-0 border-accent-metal/20 pt-60 lg:pt-60"
  >
    <div class="grid grid-cols-1 lg:grid-cols-5 lg:grid-rows-2">
      <h3 class="lg:col-start-2 lg:col-span-1 lg:row-start-1 heading-3">Services</h3>

      <h2
        class="lg:col-start-2 lg:col-span-3 lg:row-start-2 whitespace-pre-line text-balance heading-2 max-w-[70ch]"
      >
        {h.headLineText}
      </h2>
    </div>
  </section>
</div>
