---
import SurroundingsPhotoCreditCaption from "@components/surroundings-page/SurroundingsPhotoCreditCaption.astro";
import type { SurroundingsGalleryImage } from "./types";

interface Props {
  images: SurroundingsGalleryImage[];
  variant?: "accordion" | "page";
}

const { images, variant = "accordion" } = Astro.props;

const imageWidth = 1400;
const imageHeight = 1225;

const gridClass =
  variant === "page"
    ? "hidden grid-cols-1 gap-grid lg:col-span-5 lg:col-start-2 lg:grid lg:grid-cols-4 lg:row-start-5"
    : "mt-[1.6rem] grid grid-cols-1 gap-[0.8rem] md:grid-cols-2 lg:gap-[0.8rem]";
---

{
  images.length > 0 ? (
    <div class={gridClass}>
      {images.map((image, index) => (
        <figure
          data-reveal
          data-reveal-delay={String(480 + index * 80)}
          class="group/image relative aspect-[4/3.5] overflow-hidden bg-accentStone/25"
        >
          <div class="surroundings-gallery-image-container">
            <img
              src={image.src}
              srcset={image.srcSet ?? undefined}
              width={image.width ?? imageWidth}
              height={image.height ?? imageHeight}
              alt={image.alt}
              loading="lazy"
              decoding="async"
              class="surroundings-gallery-image transition-transform duration-1000 ease-out group-hover/image:scale-[1.03]"
            />
          </div>
          {image.photoCredit ? <SurroundingsPhotoCreditCaption credit={image.photoCredit} /> : null}
        </figure>
      ))}
    </div>
  ) : null
}

<style>
  .surroundings-gallery-image-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .surroundings-gallery-image-container :global(img),
  .surroundings-gallery-image-container :global(.surroundings-gallery-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>
