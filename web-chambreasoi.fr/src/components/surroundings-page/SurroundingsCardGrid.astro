---
import { Icon } from "astro-icon/components";
import PortableText from "@components/rich-text/PortableText.astro";
import RichTextBlockRenderer from "@components/rich-text/RichTextBlock.astro";
import SurroundingsCard from "./SurroundingsCard.astro";
import SurroundingsGalleryImages from "./SurroundingsGalleryImages.astro";
import type { ResolvedSurroundingsPageContent, ReservationStatus } from "./types";

interface Props {
  accordions: ResolvedSurroundingsPageContent["accordions"];
  reservationLabels: Record<ReservationStatus, string>;
}

const { accordions, reservationLabels } = Astro.props;
---

<div class="flex flex-col lg:col-span-4 lg:col-start-1 lg:row-start-4 lg:mt-[3.2rem]">
      {
        accordions.map((accordion, index) => {
          const accordionBg =
            index === 0 ? "bg-accentStone/25" : index === 1 ? "bg-accentForest/20" : "bg-accentBistre/25";

          return (
            <details class="surroundings-accordion group block border-b border-txtPri/15 first:border-t">
              <summary class="grid cursor-pointer gap-grid list-none grid-cols-4 border-txtPri/10">
                <span class="flex items-end justify-end p-[0.8rem]">
                  <span class="flex size-[1.5rem] items-start justify-center text-txtPri">
                    <Icon
                      name="ion/chevron-down-sharp"
                      class="surroundings-accordion__chevron size-[1.5rem] shrink-0 transition-transform duration-300 group-open:rotate-180"
                      aria-hidden="true"
                    />
                  </span>
                </span>

                <h3
                  class:list={[
                    "col-span-3 col-start-2 p-[0.8rem] min-h-[143px] flex items-end justify-start text-balance text-ui-lg font-semibold",
                    accordionBg,
                  ]}
                >
                  {accordion.title}
                </h3>
              </summary>

              <div class="surroundings-accordion__panel">
                <div class="surroundings-accordion__panel-inner">
                  <div class="grid grid-cols-4 gap-grid">
                    <div
                      class:list={[
                        "col-span-3 col-start-2 flex flex-col gap-[1.6rem] px-[0.8rem] pb-[1.2rem] lg:col-span-3 lg:col-start-2 lg:px-[1.2rem] lg:pb-[1.6rem]",
                        accordionBg,
                      ]}
                    >
                      {
                        accordion.description ? (
                          accordion.description.sanityBlocks ? (
                            <PortableText
                              blocks={accordion.description.sanityBlocks}
                              class="max-w-[68ch] text-balance text-ui-md leading-relaxed mt-[1.2rem]"
                            />
                          ) : (
                            <RichTextBlockRenderer
                              block={accordion.description.fallback}
                              class="max-w-[68ch] text-balance text-ui-md leading-relaxed"
                            />
                          )
                        ) : null
                      }

                      <div class="flex flex-col gap-[1.2rem]">
                        {
                          accordion.items.map((item) => (
                            <SurroundingsCard item={item} reservationLabels={reservationLabels} />
                          ))
                        }
                      </div>

                      <SurroundingsGalleryImages images={accordion.galleryImages ?? []} variant="accordion" />
                    </div>
                  </div>
                </div>
              </div>
            </details>
          );
        })
      }
</div>
