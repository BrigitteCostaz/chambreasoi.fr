---
import AvailabilityCalendar from "@components/availabily-page/AvailabilityCalendar.astro";
import Button from "@components/button/Button.astro";
import GridOverlay from "@components/layout/GridOverlay.astro";
import { getOrgData } from "@config/organization";
import {
  buildCalendarDates,
  getCalendarDisplayRange,
  resolveCalendarMinMax,
} from "@lib/availability-calendar";
import type { AvailabilityMonthResult } from "@lib/sanity";

type Props = {
  availabilityEyebrow: string;
  availabilityHeading: string;
  availabilityIntro: string;
  reservationIntro: string;
  availabilityMonths: AvailabilityMonthResult[];
};

const { availabilityEyebrow, availabilityHeading, availabilityIntro, reservationIntro, availabilityMonths } =
  Astro.props;

const now = new Date();
const currentMonthStart = `${now.getUTCFullYear()}-${String(now.getUTCMonth() + 1).padStart(2, "0")}-01`;
const { rangeStart, rangeEnd } = getCalendarDisplayRange();
const dates = buildCalendarDates(availabilityMonths);
const { minDate, maxDate } = resolveCalendarMinMax(dates, rangeStart, rangeEnd, currentMonthStart);
const orgData = await getOrgData();
const {
  contact: { phone },
} = orgData;
---

<section id="disponibilites" class="relative overflow-x-clip py-[3.6rem] lg:py-[6.4rem]">
  <GridOverlay />

  <div class="relative z-10 grid grid-cols-1 lg:grid-cols-5">
    <div
      data-reveal
      data-reveal-delay="0"
      class="flex items-center gap-grid px-[0.4rem] pb-[3.6rem] lg:col-span-1 lg:col-start-1 lg:row-start-1 lg:py-[4.8rem]"
    >
      <span class="heading-3">{availabilityEyebrow}</span>
    </div>

    <div class="px-[0.4rem] lg:col-span-4 lg:col-start-2 lg:row-start-2">
      <div data-reveal data-reveal-delay="120" class="max-w-[72ch]">
        <h1 class="heading-2 text-balance">{availabilityHeading}</h1>
        <div class="mt-[1.6rem] max-w-[65ch] space-y-[0.8rem] text-balance text-ui-lg font-medium">
          <p>{availabilityIntro}</p>
        </div>
      </div>

      <div
        data-reveal
        data-reveal-delay="240"
        class="mt-[3.2rem] bg-bgCard p-[0.8rem] lg:mt-[4.8rem] lg:p-[1.6rem]"
      >
        <AvailabilityCalendar month={currentMonthStart} dates={dates} minDate={minDate} maxDate={maxDate} />
      </div>

      <div
        id="reservation"
        data-reveal
        data-reveal-delay="360"
        class="mt-[2.4rem] flex flex-col gap-[1.6rem] sm:block lg:col-span-4 lg:col-start-2 lg:mt-[3.2rem]"
      >
        <div class="space-y-[0.8rem] text-balance text-ui-lg font-medium lg:max-w-[48ch]">
          <p class="sm:hidden">{reservationIntro}</p>
          <p class="hidden sm:block">
            {reservationIntro}
            {phone.display}
          </p>
        </div>

        <div class="sm:hidden">
          <Button class="w-full font-sans" variant="primary" size="sm" href={phone.link}>
            {phone.display}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>
