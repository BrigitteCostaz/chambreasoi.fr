---
import { sanityClient } from "sanity:client";
import AvailabilityCalendar from "@components/availabily-page/AvailabilityCalendar.astro";
import Button from "@components/button/Button.astro";
import { getOrgData } from "@config/organization";

type AvailabilityDate = {
  date: string;
  available?: boolean;
};

type AvailabilityMonth = {
  month: string;
  dates?: AvailabilityDate[];
};

function getMonthDays(month: string) {
  const year = Number(month.slice(0, 4));
  const monthIndex = Number(month.slice(5, 7)) - 1;
  const daysInMonth = new Date(Date.UTC(year, monthIndex + 1, 0)).getUTCDate();

  return Array.from({ length: daysInMonth }, (_, index) => {
    const day = String(index + 1).padStart(2, "0");

    return `${month.slice(0, 7)}-${day}`;
  });
}

const now = new Date();
const currentMonthStart = `${now.getUTCFullYear()}-${String(now.getUTCMonth() + 1).padStart(2, "0")}-01`;
const availabilityMonths = await sanityClient.fetch<AvailabilityMonth[]>(
  `*[_type == "availability" && !(_id in path("drafts.**"))] | order(month asc){
    month,
    dates[]{ date, available }
  }`
);
const orgData = await getOrgData();
const {
  contact: { phone },
} = orgData;
const dates = availabilityMonths.flatMap(({ month, dates = [] }) => {
  const availabilityByDate = new Map(dates.map(({ date, available }) => [date, available]));

  return getMonthDays(month).map((date) => {
    const available = availabilityByDate.get(date);

    return typeof available === "boolean" ? { date, available } : { date };
  });
});
---

<section id="disponibilites" class="relative overflow-x-clip py-[3.6rem] lg:py-[6.4rem]">
  <div class="pointer-events-none absolute inset-0 z-0 translate-x-[0.15rem]">
    <div class="grid size-full grid-cols-2 gap-4 lg:hidden"></div>
    <div class="hidden size-full grid-cols-5 gap-grid lg:grid">
      <div class="grid-line"></div>
      <div class="grid-line"></div>
      <div class="grid-line"></div>
      <div class="grid-line"></div>
      <div></div>
    </div>
  </div>

  <div class="relative z-10 grid grid-cols-1 lg:grid-cols-5">
    <div
      data-reveal
      data-reveal-delay="0"
      class="flex items-center gap-grid px-[0.4rem] pb-[3.6rem] lg:col-span-1 lg:col-start-1 lg:row-start-1 lg:py-[4.8rem]"
    >
      <span class="heading-3">Disponibilités</span>
    </div>

    <div class="px-[0.4rem] lg:col-span-4 lg:col-start-2 lg:row-start-2">
      <div data-reveal data-reveal-delay="120" class="max-w-[72ch]">
        <h1 class="heading-2 text-balance">Agenda</h1>
        <div class="mt-[1.6rem] max-w-[65ch] space-y-[0.8rem] text-balance text-ui-lg font-medium">
          <slot name="intro" />
        </div>
      </div>

      <div
        data-reveal
        data-reveal-delay="240"
        class="mt-[3.2rem] bg-bgCard p-[0.8rem] lg:mt-[4.8rem] lg:p-[1.6rem]"
      >
        <AvailabilityCalendar month={currentMonthStart} dates={dates} />
      </div>

      <div
        id="reservation"
        data-reveal
        data-reveal-delay="360"
        class="mt-[2.4rem] flex flex-col gap-[1.6rem] lg:mt-[3.2rem] lg:max-w-[58ch]"
      >
        <div class="space-y-[0.8rem] text-balance text-ui-lg font-medium">
          <p>Pour réserver une date ou poser une question sur votre venue, contactez-nous au</p>
        </div>

        <Button
          class="w-full font-sans sm:w-max"
          variant="primary"
          size="sm"
          href={phone.link}
        >
          {phone.display}
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]");

  revealEls.forEach((el) => {
    const delay = el.dataset.revealDelay ?? "0";
    el.style.setProperty("--reveal-delay", `${delay}ms`);
  });

  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        requestAnimationFrame(() => {
          (entry.target as HTMLElement).classList.add("is-visible");
        });

        revealObserver.unobserve(entry.target);
      });
    },
    { threshold: 0.1 }
  );

  revealEls.forEach((el) => revealObserver.observe(el));
</script>
