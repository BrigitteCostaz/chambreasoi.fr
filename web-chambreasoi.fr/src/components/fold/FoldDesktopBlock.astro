---
import { Image } from "astro:assets";
import Button from "@components/button/Button.astro";

interface Props {
  leftColors: string[];
  leftColorsReversed: string[];
  squareCells: Array<{ align: string; type: string | null }>;
  f: {
    mosaicTile1Text: string;
    mosaicTile2Line1: string;
    mosaicTile2Line2: string;
    amenitiesLabel: string;
    amenities: readonly string[];
    bookingNote: string;
  };
  baseNightly1PersonEuroFR: string;
  phoneLink: string;
  phoneDisplay: string;
  shouldRenderSanityImage: boolean;
  sanitySrc: string | null;
  sanitySrcSet: string | null;
  shouldRenderFallback: boolean;
  fallbackImage: ImageMetadata | null;
  imageAlt: string;
  coverWidth: number;
  coverHeight: number;
}

const {
  leftColors,
  leftColorsReversed,
  squareCells,
  f,
  baseNightly1PersonEuroFR,
  phoneLink,
  phoneDisplay,
  shouldRenderSanityImage,
  sanitySrc,
  sanitySrcSet,
  shouldRenderFallback,
  fallbackImage,
  imageAlt,
  coverWidth,
  coverHeight,
} = Astro.props;
---

<div class="hidden w-full flex-row gap-grid xl:flex xl:flex-1">
  <div class="relative flex flex-1 flex-col gap-grid">
    <div class="relative w-full">
      <div class="pointer-events-none absolute inset-0">
        <div class="grid h-full grid-cols-3 gap-grid">
          {leftColors.map((bgColor) => <div class:list={["relative", bgColor]} />)}
        </div>
      </div>
      <div class="relative z-10 grid w-full grid-cols-3 gap-grid">
        {
          squareCells.map((cell) => (
            <div class={`aspect-square flex ${cell.align} p-[0.8rem]`}>
              {cell.type === "heading" && <span aria-hidden="true" class="heading-1">{f.mosaicTile1Text}</span>}
              {cell.type === "amenities" && (
                <ul class="flex flex-col font-display font-medium leading-none text-txtPri text-[clamp(18px,calc(18px+22.5*(100vw-375px)/1225),22.5px)] [list-style-type:none] [list-style-position:inside]">
                  <li class="pb-2">{f.amenitiesLabel}</li>
                  {f.amenities.map((item: string) => <li class="text-txtMuted">{item}</li>)}
                </ul>
              )}
            </div>
          ))
        }
      </div>
    </div>
    <div class="relative flex flex-1">
      <div class="pointer-events-none absolute inset-0">
        <div class="grid h-full grid-cols-3 gap-grid">
          {leftColorsReversed.map((bgColor) => <div class:list={["relative", bgColor]} />)}
        </div>
      </div>
      <div class="relative z-10 grid w-full grid-cols-3 gap-grid">
        <div></div>
        <div class="flex flex-col items-start p-[0.8rem] text-left" aria-hidden="true">
          <span class="heading-1 pb-2">{f.mosaicTile2Line1}</span>
          <span class="heading-1 text-txtMuted">{f.mosaicTile2Line2}</span>
        </div>
        <div class="flex flex-col justify-end font-display font-medium p-[0.8rem] text-left text-[clamp(18px,calc(18px+22.5*(100vw-375px)/1225),22.5px)]">
          <div>
            <p class="text-primary pb-2">à partir de {baseNightly1PersonEuroFR} la nuitée</p>
            <p class="text-muted uppercase tracking-wider pb-6">{f.bookingNote}</p>
          </div>
          <Button variant="accent" size="sm" icon="ion/call-sharp" href={phoneLink} class="inline-flex font-sans font-400 w-full items-center justify-center">
            {phoneDisplay}
          </Button>
        </div>
      </div>
    </div>
  </div>
  <div class="relative flex flex-col" style="flex: 0 0 calc(40% - 0.2rem);">
    <div class="fold-image-container">
      {
        shouldRenderSanityImage ? (
          <img src={sanitySrc!} srcset={sanitySrcSet ?? undefined} sizes="(max-width: 1024px) 100vw, 40vw" alt={imageAlt} loading="eager" decoding="async" fetchpriority="high" class="fold-image" />
        ) : shouldRenderFallback ? (
          <Image src={fallbackImage!} alt={imageAlt} width={coverWidth} height={coverHeight} densities={[1, 1.5, 2]} loading="eager" decoding="async" class="fold-image" />
        ) : null
      }
    </div>
    <div class="pointer-events-none absolute top-0 bottom-0 left-1/2 w-[0.4rem] -translate-x-1/2 bg-bgBase z-1 lg:translate-x-0"></div>
    <div class="relative w-full border-b-[0.4rem] border-bgBase box-content">
      <div class="relative z-10 grid w-full grid-cols-2 gap-grid">
        <div class="aspect-square"></div>
        <div class="aspect-square"></div>
      </div>
    </div>
    <div class="relative flex-1">
      <div class="relative z-10 grid w-full h-full grid-cols-2">
        <div></div>
        <div class="flex items-end p-[0.8rem]">
          <Button class="inline-flex font-sans w-full items-center justify-center" variant="primary" size="sm" href="/la-chambre">
            Découvrir la chambre
          </Button>
        </div>
      </div>
    </div>
  </div>
</div>
