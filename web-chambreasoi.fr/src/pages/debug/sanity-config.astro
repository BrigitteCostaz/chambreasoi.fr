---
import { getAccommodation } from "@config/accomodation";
import { getHeadData } from "@config/head";
import { getOrgData } from "@config/organization";
import { getPricing } from "@config/pricing";

const isDev = import.meta.env.DEV;

if (!isDev) {
  return Astro.redirect("/");
}

const orgData = await getOrgData();
const pricing = await getPricing();
const accommodation = await getAccommodation();
const headData = await getHeadData();
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Debug Sanity Config</title>
  </head>
  <body>
    <main>
      <h1>Debug Sanity Config</h1>
      <p>Visible uniquement en développement.</p>

      <h2>Organization</h2>
      <pre>{JSON.stringify(orgData, null, 2)}</pre>

      <h2>Pricing</h2>
      <pre>{JSON.stringify(pricing, null, 2)}</pre>

      <h2>Accommodation</h2>
      <pre>{JSON.stringify(accommodation, null, 2)}</pre>

      <h2>Head</h2>
      <pre>{JSON.stringify(headData, null, 2)}</pre>
    </main>
  </body>
</html>
