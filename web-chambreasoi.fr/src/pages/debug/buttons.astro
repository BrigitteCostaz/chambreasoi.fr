---
import Button from "@components/button/Button.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class="bg-bgBase text-txtPri min-h-screen p-8 dark:bg-dark-bgBase dark:text-dark-txtPri">
    <div class="mx-auto max-w-6xl space-y-12">
      <header>
        <h1 class="heading-1">Button Component Examples</h1>
        <p class="text-txtMuted dark:text-dark-txtMuted">
          Demonstrating button variants with the project color system using OKLCH colors
        </p>
      </header>

      <!-- Variants Section -->
      <section class="space-y-4">
        <h2 class="text-txtPri dark:text-dark-txtPri text-2xl font-semibold">Variants</h2>
        <div class="flex flex-wrap gap-4">
          <Button variant="primary">Primary Button</Button>
          <Button variant="secondary">Secondary Button</Button>
          <Button variant="accent">Accent Button</Button>
          <Button variant="outline">Outline Button</Button>
          <Button variant="ghost">Ghost Button</Button>
          <Button variant="link">Link Button</Button>
        </div>
      </section>

      <!-- Sizes Section -->
      <section class="space-y-4">
        <h2 class="text-txtPri dark:text-dark-txtPri text-2xl font-semibold">Sizes</h2>
        <div class="flex flex-wrap items-center gap-4">
          <Button variant="primary" size="sm">Small</Button>
          <Button variant="primary" size="default">Default</Button>
          <Button variant="primary" size="lg">Large</Button>
        </div>
      </section>

      <!-- Link Buttons -->
      <section class="space-y-4">
        <h2 class="text-txtPri dark:text-dark-txtPri text-2xl font-semibold">Link Buttons</h2>
        <p class="text-txtMuted dark:text-dark-txtMuted text-sm">
          Buttons can render as <code
            class="bg-bgAlt dark:bg-dark-bgAlt rounded px-1.5 py-0.5 text-xs">&lt;a&gt;</code
          > tags when using the <code
            class="bg-bgAlt dark:bg-dark-bgAlt rounded px-1.5 py-0.5 text-xs">href</code
          > prop
        </p>
        <div class="flex flex-wrap gap-4">
          <Button variant="primary" href="/about">About Page</Button>
          <Button variant="secondary" href="/contact">Contact</Button>
          <Button variant="accent" href="/gallery">View Gallery</Button>
          <Button variant="outline" href="/blog">Blog</Button>
        </div>
      </section>

      <!-- External Links with Security -->
      <section class="space-y-4">
        <h2 class="text-txtPri dark:text-dark-txtPri text-2xl font-semibold">
          External Links (with Security)
        </h2>
        <p class="text-txtMuted dark:text-dark-txtMuted text-sm">
          External links with <code
            class="bg-bgAlt dark:bg-dark-bgAlt rounded px-1.5 py-0.5 text-xs">target="_blank"</code
          > automatically get <code
            class="bg-bgAlt dark:bg-dark-bgAlt rounded px-1.5 py-0.5 text-xs"
            >rel="noopener noreferrer"</code
          >
        </p>
        <div class="flex flex-wrap gap-4">
          <Button variant="primary" href="https://example.com" target="_blank">
            External Link
          </Button>
          <Button variant="secondary" href="https://github.com" target="_blank"> GitHub </Button>
          <Button variant="link" href="https://docs.astro.build" target="_blank">
            Documentation →
          </Button>
        </div>
      </section>

      <!-- Disabled Links -->
      <section class="space-y-4">
        <h2 class="text-txtPri dark:text-dark-txtPri text-2xl font-semibold">Disabled Links</h2>
        <p class="text-txtMuted dark:text-dark-txtMuted text-sm">
          Links with <code class="bg-bgAlt dark:bg-dark-bgAlt rounded px-1.5 py-0.5 text-xs"
            >disabled</code
          > prop use <code class="bg-bgAlt dark:bg-dark-bgAlt rounded px-1.5 py-0.5 text-xs"
            >aria-disabled</code
          > and <code class="bg-bgAlt dark:bg-dark-bgAlt rounded px-1.5 py-0.5 text-xs"
            >pointer-events-none</code
          >
        </p>
        <div class="flex flex-wrap gap-4">
          <Button variant="primary" href="/page" disabled>Disabled Link</Button>
          <Button variant="secondary" href="/page" disabled>Disabled Link</Button>
          <Button variant="outline" href="/page" disabled>Disabled Link</Button>
        </div>
      </section>

      <!-- All Variants with All Sizes -->
      <section class="space-y-6">
        <h2 class="text-txtPri dark:text-dark-txtPri text-2xl font-semibold">
          All Variants × All Sizes
        </h2>

        <div class="space-y-4">
          <div>
            <h3 class="text-txtMuted dark:text-dark-txtMuted mb-2 text-sm font-medium">Primary</h3>
            <div class="flex flex-wrap items-center gap-3">
              <Button variant="primary" size="sm">Small</Button>
              <Button variant="primary" size="default">Default</Button>
              <Button variant="primary" size="lg">Large</Button>
            </div>
          </div>

          <div>
            <h3 class="text-txtMuted dark:text-dark-txtMuted mb-2 text-sm font-medium">
              Secondary
            </h3>
            <div class="flex flex-wrap items-center gap-3">
              <Button variant="secondary" size="sm">Small</Button>
              <Button variant="secondary" size="default">Default</Button>
              <Button variant="secondary" size="lg">Large</Button>
            </div>
          </div>

          <div>
            <h3 class="text-txtMuted dark:text-dark-txtMuted mb-2 text-sm font-medium">Accent</h3>
            <div class="flex flex-wrap items-center gap-3">
              <Button variant="accent" size="sm">Small</Button>
              <Button variant="accent" size="default">Default</Button>
              <Button variant="accent" size="lg">Large</Button>
            </div>
          </div>

          <div>
            <h3 class="text-txtMuted dark:text-dark-txtMuted mb-2 text-sm font-medium">Outline</h3>
            <div class="flex flex-wrap items-center gap-3">
              <Button variant="outline" size="sm">Small</Button>
              <Button variant="outline" size="default">Default</Button>
              <Button variant="outline" size="lg">Large</Button>
            </div>
          </div>

          <div>
            <h3 class="text-txtMuted dark:text-dark-txtMuted mb-2 text-sm font-medium">Ghost</h3>
            <div class="flex flex-wrap items-center gap-3">
              <Button variant="ghost" size="sm">Small</Button>
              <Button variant="ghost" size="default">Default</Button>
              <Button variant="ghost" size="lg">Large</Button>
            </div>
          </div>

          <div>
            <h3 class="text-txtMuted dark:text-dark-txtMuted mb-2 text-sm font-medium">Link</h3>
            <div class="flex flex-wrap items-center gap-3">
              <Button variant="link" size="sm">Small</Button>
              <Button variant="link" size="default">Default</Button>
              <Button variant="link" size="lg">Large</Button>
            </div>
          </div>
        </div>
      </section>

      <!-- Disabled State -->
      <section class="space-y-4">
        <h2 class="text-txtPri dark:text-dark-txtPri text-2xl font-semibold">Disabled State</h2>
        <div class="flex flex-wrap gap-4">
          <Button variant="primary" disabled>Disabled Primary</Button>
          <Button variant="secondary" disabled>Disabled Secondary</Button>
          <Button variant="accent" disabled>Disabled Accent</Button>
          <Button variant="outline" disabled>Disabled Outline</Button>
          <Button variant="ghost" disabled>Disabled Ghost</Button>
          <Button variant="link" disabled>Disabled Link</Button>
        </div>
      </section>

      <!-- Button Types -->
      <section class="space-y-4">
        <h2 class="text-txtPri dark:text-dark-txtPri text-2xl font-semibold">Button Types</h2>
        <div class="flex flex-wrap gap-4">
          <Button variant="primary" type="button">Button</Button>
          <Button variant="secondary" type="submit">Submit</Button>
          <Button variant="outline" type="reset">Reset</Button>
        </div>
      </section>

      <!-- Custom Classes -->
      <section class="space-y-4">
        <h2 class="text-txtPri dark:text-dark-txtPri text-2xl font-semibold">
          With Custom Classes
        </h2>
        <div class="flex flex-wrap gap-4">
          <Button variant="primary" class="w-full md:w-auto">Full Width on Mobile</Button>
          <Button variant="secondary" class="shadow-xl">With Extra Shadow</Button>
          <Button variant="accent" class="tracking-wide uppercase">Uppercase</Button>
          <Button variant="outline" class="min-w-32">Min Width</Button>
        </div>
      </section>

      <!-- Color System Reference -->
      <section class="space-y-4">
        <h2 class="text-txtPri dark:text-dark-txtPri text-2xl font-semibold">
          Color System Reference
        </h2>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
          <!-- Backgrounds -->
          <div
            class="border-txtMuted/20 dark:border-dark-txtMuted/20 space-y-2 rounded-lg border p-4"
          >
            <div
              class="bg-bgBase dark:bg-dark-bgBase flex h-12 items-center justify-center rounded border border-txtMuted/20"
            >
              <span class="text-txtPri dark:text-dark-txtPri text-sm font-medium">bgBase</span>
            </div>
            <div class="bg-bgAlt dark:bg-dark-bgAlt flex h-12 items-center justify-center rounded">
              <span class="text-txtPri dark:text-dark-txtPri text-sm font-medium">bgAlt</span>
            </div>
            <div
              class="bg-bgCard dark:bg-dark-bgCard flex h-12 items-center justify-center rounded border border-txtMuted/20"
            >
              <span class="text-txtPri dark:text-dark-txtPri text-sm font-medium">bgCard</span>
            </div>
          </div>

          <!-- Text -->
          <div
            class="border-txtMuted/20 dark:border-dark-txtMuted/20 space-y-2 rounded-lg border p-4 bg-bgCard dark:bg-dark-bgCard"
          >
            <div class="flex h-12 items-center justify-center rounded">
              <span class="text-txtPri dark:text-dark-txtPri text-sm font-semibold">txtPri</span>
            </div>
            <div class="flex h-12 items-center justify-center rounded">
              <span class="text-txtMuted dark:text-dark-txtMuted text-sm font-semibold"
                >txtMuted</span
              >
            </div>
          </div>

          <!-- Accent Forest -->
          <div
            class="border-txtMuted/20 dark:border-dark-txtMuted/20 space-y-2 rounded-lg border p-4"
          >
            <div
              class="bg-accentForest dark:bg-dark-accentForest flex h-16 items-center justify-center rounded"
            >
              <span class="text-bgBase dark:text-dark-bgBase font-semibold">accentForest</span>
            </div>
          </div>

          <!-- Accent Stone -->
          <div
            class="border-txtMuted/20 dark:border-dark-txtMuted/20 space-y-2 rounded-lg border p-4"
          >
            <div
              class="bg-accentStone dark:bg-dark-accentStone flex h-16 items-center justify-center rounded"
            >
              <span class="text-bgBase dark:text-dark-bgBase font-semibold">accentStone</span>
            </div>
          </div>

          <!-- Accent Terra -->
          <div
            class="border-txtMuted/20 dark:border-dark-txtMuted/20 space-y-2 rounded-lg border p-4"
          >
            <div
              class="bg-accentTerra dark:bg-dark-accentTerra flex h-16 items-center justify-center rounded"
            >
              <span class="text-bgBase dark:text-dark-bgBase font-semibold">accentTerra</span>
            </div>
          </div>

          <!-- Accent Bistre -->
          <div
            class="border-txtMuted/20 dark:border-dark-txtMuted/20 space-y-2 rounded-lg border p-4"
          >
            <div
              class="bg-accentBistre dark:bg-dark-accentBistre flex h-16 items-center justify-center rounded"
            >
              <span class="text-bgBase dark:text-dark-bgBase font-semibold">accentBistre</span>
            </div>
          </div>

          <!-- Accent Burgundy -->
          <div
            class="border-txtMuted/20 dark:border-dark-txtMuted/20 space-y-2 rounded-lg border p-4"
          >
            <div
              class="bg-accentBurgundy dark:bg-dark-accentBurgundy flex h-16 items-center justify-center rounded"
            >
              <span class="text-bgBase dark:text-dark-bgBase font-semibold">accentBurgundy</span>
            </div>
          </div>

          <!-- Info -->
          <div
            class="border-txtMuted/20 dark:border-dark-txtMuted/20 space-y-2 rounded-lg border p-4"
          >
            <div class="bg-info dark:bg-dark-info flex h-16 items-center justify-center rounded">
              <span class="text-bgBase dark:text-dark-bgBase font-semibold">info</span>
            </div>
          </div>

          <!-- Warning -->
          <div
            class="border-txtMuted/20 dark:border-dark-txtMuted/20 space-y-2 rounded-lg border p-4"
          >
            <div
              class="bg-warning dark:bg-dark-warning flex h-16 items-center justify-center rounded"
            >
              <span class="text-bgBase dark:text-dark-bgBase font-semibold">warning</span>
            </div>
          </div>

          <!-- Alert -->
          <div
            class="border-txtMuted/20 dark:border-dark-txtMuted/20 space-y-2 rounded-lg border p-4"
          >
            <div class="bg-alert dark:bg-dark-alert flex h-16 items-center justify-center rounded">
              <span class="text-bgBase dark:text-dark-bgBase font-semibold">alert</span>
            </div>
          </div>

          <!-- Success -->
          <div
            class="border-txtMuted/20 dark:border-dark-txtMuted/20 space-y-2 rounded-lg border p-4"
          >
            <div
              class="bg-success dark:bg-dark-success flex h-16 items-center justify-center rounded"
            >
              <span class="text-bgBase dark:text-dark-bgBase font-semibold">success</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Usage Examples -->
      <section class="space-y-4">
        <h2 class="text-txtPri dark:text-dark-txtPri text-2xl font-semibold">Usage Examples</h2>
        <div
          class="bg-bgCard dark:bg-dark-bgCard text-txtPri dark:text-dark-txtPri border-txtMuted/20 dark:border-dark-txtMuted/20 rounded-lg border p-6"
        >
          <pre
            class="overflow-x-auto text-sm"><code>{`<!-- Basic button -->
<Button variant="primary">Click me</Button>

<!-- Submit button -->
<Button variant="primary" type="submit">Submit Form</Button>

<!-- Link button (renders as <a>) -->
<Button variant="primary" href="/about">About Page</Button>

<!-- External link (auto-adds rel="noopener noreferrer") -->
<Button variant="secondary" href="https://example.com" target="_blank">
  External Link
</Button>

<!-- Disabled button -->
<Button variant="accent" disabled>Can't Click</Button>

<!-- Disabled link (uses aria-disabled) -->
<Button variant="primary" href="/page" disabled>
  Disabled Link
</Button>

<!-- With size -->
<Button variant="secondary" size="lg">Large Button</Button>

<!-- With custom classes -->
<Button variant="outline" class="w-full">Full Width</Button>

<!-- Link variant -->
<Button variant="link" href="/learn-more">Learn more</Button>`}</code></pre>
        </div>
      </section>

      <!-- Implementation Details -->
      <section class="space-y-4">
        <h2 class="text-txtPri dark:text-dark-txtPri text-2xl font-semibold">How It Works</h2>
        <div
          class="bg-bgCard dark:bg-dark-bgCard text-txtPri dark:text-dark-txtPri border-txtMuted/20 dark:border-dark-txtMuted/20 space-y-6 rounded-lg border p-6"
        >
          <div>
            <h3 class="mb-2 text-lg font-semibold">1. Polymorphic Component</h3>
            <p class="text-txtMuted dark:text-dark-txtMuted mb-3 text-sm">
              Renders as <code class="bg-muted rounded px-1">&lt;button&gt;</code> or <code
                class="bg-muted rounded px-1">&lt;a&gt;</code
              > based on props
            </p>
            <pre
              class="bg-bgAlt dark:bg-dark-bgAlt overflow-x-auto rounded p-4 text-sm"><code>{`// Discriminated union types
type ButtonProps = BaseProps & {
  href?: never;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
};

type LinkProps = BaseProps & {
  href: string;
  type?: never;
  disabled?: boolean; // Visual only
  target?: string;
  rel?: string;
};

// Component selection
const Component = href ? 'a' : 'button';`}</code></pre>
          </div>

          <div>
            <h3 class="mb-2 text-lg font-semibold">2. Security Features</h3>
            <p class="text-txtMuted dark:text-dark-txtMuted mb-3 text-sm">
              Auto-adds <code class="bg-bgAlt dark:bg-dark-bgAlt rounded px-1"
                >rel="noopener noreferrer"</code
              > for external links
            </p>
            <pre
              class="bg-bgAlt dark:bg-dark-bgAlt overflow-x-auto rounded p-4 text-sm"><code>{`// Security: Auto-add rel for target="_blank"
let finalRel = rel;
if (isLink && target === '_blank' && !rel) {
  finalRel = 'noopener noreferrer';
}`}</code></pre>
          </div>

          <div>
            <h3 class="mb-2 text-lg font-semibold">3. Accessibility</h3>
            <p class="text-txtMuted dark:text-dark-txtMuted mb-3 text-sm">
              Disabled links use <code class="bg-bgAlt dark:bg-dark-bgAlt rounded px-1"
                >aria-disabled</code
              > + <code class="bg-bgAlt dark:bg-dark-bgAlt rounded px-1">pointer-events-none</code>
            </p>
            <pre
              class="bg-bgAlt dark:bg-dark-bgAlt overflow-x-auto rounded p-4 text-sm"><code>{`// Links don't have native disabled
const ariaDisabled = isLink && disabled ? 'true' : undefined;
const tabIndex = isLink && disabled ? -1 : undefined;

/* CSS */
a.button[aria-disabled="true"] {
  @apply pointer-events-none opacity-50 cursor-not-allowed;
}`}</code></pre>
          </div>

          <div>
            <h3 class="mb-2 text-lg font-semibold">4. Scoped Styles with @apply</h3>
            <p class="text-txtMuted dark:text-dark-txtMuted mb-3 text-sm">
              UnoCSS utilities are applied via --at-apply directive
            </p>
            <pre
              class="bg-bgAlt dark:bg-dark-bgAlt overflow-x-auto rounded p-4 text-sm"><code>{`.button--primary {
  @apply bg-accentForest text-bgBase
    hover:bg-accentStone active:bg-accentForest/80
    shadow-sm;
}`}</code></pre>
          </div>

          <div>
            <h3 class="mb-2 text-lg font-semibold">
              5. Color System (config/colors.ts + uno.config.ts)
            </h3>
            <p class="text-txtMuted dark:text-dark-txtMuted mb-3 text-sm">
              Colors are defined in OKLCH format for better perceptual uniformity
            </p>
            <pre
              class="bg-bgAlt dark:bg-dark-bgAlt overflow-x-auto rounded p-4 text-sm"><code>{`light: {
  bgBase: "oklch(96.1% 0.026 119deg)",
  accentForest: "oklch(48.0% 0.084 145deg)",
  txtPri: "oklch(30.3% 0.005 122deg)",
  // ... more colors
}`}</code></pre>
          </div>

          <div>
            <h3 class="mb-2 text-lg font-semibold">6. Dark Mode Support</h3>
            <p class="text-txtMuted dark:text-dark-txtMuted mb-3 text-sm">
              Dark mode uses class-based switching with dark- prefixed colors
            </p>
            <pre
              class="bg-bgAlt dark:bg-dark-bgAlt overflow-x-auto rounded p-4 text-sm"><code>{`// Dark colors are prefixed with 'dark-'
dark: {
  bgBase: "oklch(16% 0.018 119deg)",
  accentForest: "oklch(64% 0.094 145deg)",
  // ... more colors
})`}</code></pre>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
