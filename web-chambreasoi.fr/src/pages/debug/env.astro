---
import { getPublicSanityEnv, readEnv } from "@utils/env";
import { getRuntimeEnv } from "@utils/runtime-env";

const isDev = import.meta.env.DEV;

// Only allow in development
if (!isDev) {
  return Astro.redirect("/");
}

/**
 * Safely summarize an env-like object without dumping everything.
 * (Never print secrets; we only show allowlisted keys.)
 */
function pickKeys(obj: unknown, keys: string[]) {
  const out: Record<string, unknown> = {};
  const rec = (obj ?? {}) as Record<string, unknown>;
  for (const k of keys) out[k] = rec[k];
  return out;
}

const allowlist = [
  "PUBLIC_SANITY_PROJECT_ID",
  "PUBLIC_SANITY_DATASET",
  "SANITY_PROJECT_ID",
  "SANITY_DATASET",
  "SANITY_STUDIO_PROJECT_ID",
  "SANITY_STUDIO_DATASET",
  "ENABLE_SANITY_STUDIO",
];

// Node-dev compatible runtime env:
// - On Cloudflare Workers, getRuntimeEnv() will return bindings (via dynamic import).
// - On Node dev, it falls back to process.env.
const runtimeEnv = await getRuntimeEnv();

const processEnvPick = pickKeys(
  typeof process !== "undefined" ? process.env : undefined,
  allowlist
);
const runtimeEnvPick = pickKeys(runtimeEnv, allowlist);

const importMetaPick = {
  PUBLIC_SANITY_PROJECT_ID: import.meta.env.PUBLIC_SANITY_PROJECT_ID,
  PUBLIC_SANITY_DATASET: import.meta.env.PUBLIC_SANITY_DATASET,
  PROD: import.meta.env.PROD,
  DEV: import.meta.env.DEV,
};

// Derived reads via helper
const sanityFromRuntime = (() => {
  try {
    return getPublicSanityEnv(runtimeEnv as unknown as Record<string, unknown>);
  } catch (e) {
    return { error: String(e) };
  }
})();

const sanityFromBestEffort = (() => {
  try {
    // readEnv() already falls back across runtime/process/import.meta (PUBLIC_ only)
    const projectId =
      readEnv("PUBLIC_SANITY_PROJECT_ID", runtimeEnv) ??
      readEnv("SANITY_PROJECT_ID", runtimeEnv) ??
      readEnv("SANITY_STUDIO_PROJECT_ID", runtimeEnv);

    const dataset =
      readEnv("PUBLIC_SANITY_DATASET", runtimeEnv) ??
      readEnv("SANITY_DATASET", runtimeEnv) ??
      readEnv("SANITY_STUDIO_DATASET", runtimeEnv) ??
      "production";

    return { projectId, dataset };
  } catch (e) {
    return { error: String(e) };
  }
})();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Debug Env</title>
    <style>
      body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; padding: 16px; }
      pre { background: #0b1020; color: #e6edf3; padding: 12px; overflow: auto; border-radius: 8px; }
      h2 { margin-top: 24px; }
      code { background: #f3f4f6; padding: 2px 6px; border-radius: 6px; }
    </style>
  </head>
  <body>
    <main>
      <h1>Debug Env</h1>
      <p>
        This route is only available in <code>dev</code>. It prints an allowlisted subset of env
        sources to validate local vs Cloudflare runtime parity.
      </p>

      <h2>import.meta.env (allowlisted)</h2>
      <pre>{JSON.stringify(importMetaPick, null, 2)}</pre>

      <h2>Runtime env (allowlisted)</h2>
      <p>
        Source: <code>@utils/runtime-env</code> (Cloudflare bindings in Workers; <code>process.env</code> in Node dev)
      </p>
      <pre>{JSON.stringify(runtimeEnvPick, null, 2)}</pre>

      <h2>process.env (allowlisted)</h2>
      <pre>{JSON.stringify(processEnvPick, null, 2)}</pre>

      <h2>Derived (getPublicSanityEnv(runtimeEnv))</h2>
      <pre>{JSON.stringify(sanityFromRuntime, null, 2)}</pre>

      <h2>Derived (best-effort readEnv fallbacks)</h2>
      <pre>{JSON.stringify(sanityFromBestEffort, null, 2)}</pre>

      <h2>Notes</h2>
      <ul>
        <li>
          This page intentionally avoids importing <code>cloudflare:workers</code> so it remains Node-dev compatible.
        </li>
        <li>
          In local dev, <code>import.meta.env.PUBLIC_*</code> should reflect your <code>.env</code>.
        </li>
        <li>
          Never print secrets here. Keep this page allowlist-only.
        </li>
      </ul>
    </main>
  </body>
</html>
