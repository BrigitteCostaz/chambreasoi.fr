---
import BaseLayout from "@layouts/BaseLayout.astro";
import Fold from "@components/fold/Fold.astro";
import { buildSanityImageUrl, fetchSanity, TEST_CONTENT_LIST_QUERY } from "../lib/sanity";

type TestContentListItem = {
  _id: string;
  title?: string;
  slug?: string;
  excerpt?: string;
  image?: {
    alt?: string;
    asset?: {
      _ref?: string;
      _id?: string;
      url?: string;
    };
  };
};

const items =
  (await fetchSanity<TestContentListItem[]>(
    TEST_CONTENT_LIST_QUERY,
    undefined,
    // SSR/build friendly: avoid CDN caching by default for freshness
    { useCdn: false }
  )) ?? [];
---

<BaseLayout>
  <Fold />
</BaseLayout>
