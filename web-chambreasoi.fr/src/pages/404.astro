---
import Content404 from "@components/404/404Content.astro";
import GridOverlay from "@components/layout/GridOverlay.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

Astro.response.status = 404;
---

<BaseLayout pageKey="notFound">
  <section class="relative overflow-x-clip py-[.8rem] lg:py-[0] lg:pb-[4.8rem]">
    <GridOverlay />

    <div
      class="relative z-10 grid grid-cols-1 gap-grid py-[6rem] lg:grid-cols-5 bg-accentTerra/20 lg:bg-accentForest/20 lg:py-[8rem]"
    >
      <div
        class="col-span-full flex flex-col gap-[3.2rem] px-[0.4rem] lg:col-span-4 lg:col-start-2"
      >
        <p class="text-ui-md uppercase tracking-wide">404</p>
        <h1 class="heading-2 text-balance">Page introuvable</h1>
      </div>
    </div>

    <Content404 />
  </section>
</BaseLayout>
