---
import { Image } from "astro:assets";
import GridOverlay from "@components/layout/GridOverlay.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  buildSanityDprSrcSet,
  buildSanityImageUrl,
  getRoomPageContent,
  type RoomPageAccent,
  type RoomPageCardResult,
  type RoomPageImageResult,
  type RoomPageSectionResult,
} from "@lib/sanity";
import { resolveImage } from "@utils/imageUtils";
import { Icon } from "astro-icon/components";

type Accent = RoomPageAccent;
type GalleryOrientation = "landscape" | "portrait";

interface ContentCard {
  _key?: string;
  title: string;
  body: string;
  accent: Accent;
}

interface GalleryImage {
  image: ImageMetadata | null;
  alt: string;
  sanityImage?: RoomPageImageResult | null;
  sanitySrc?: string | null;
  sanitySrcSet?: string | null;
}

const roomPageContent = await getRoomPageContent();

const accentClasses: Record<Accent, string> = {
  stone: "bg-accentStone/25",
  forest: "bg-accentForest/20",
  bistre: "bg-accentBistre/25",
};
const serviceFeatureImage = null;
// later, when needed:
// const serviceFeatureImage = room03Image;
const room01Image = resolveImage("@images/chambreasoi-room-01.png");
const room02Image = resolveImage("@images/chambreasoi-room-02.png");
const livingroom01Image = resolveImage("@images/chambreasoi-livingroom-01.png");
const livingroom02Image = resolveImage("@images/chambreasoi-livingroom-02.png");
const livingroom03Image = resolveImage("@images/chambreasoi-livingroom-03.png");
const bathroom01Image = resolveImage("@images/chambreasoi-bathroom-01.png");
const terrace01Image = resolveImage("@images/chambreasoi-terrace-01.png");
const cuisineImage = resolveImage("@images/chambreasoi-cuisine.png");
const gardenImage01 = resolveImage("@images/chambreasoi-garden-01.png");
const gardenImage02 = resolveImage("@images/chambreasoi-garden-02.png");
const gardenImage03 = resolveImage("@images/chambreasoi-garden-03.png");
const defaultPrivateCards: ContentCard[] = [
  {
    title: "La chambre",
    body: "Une chambre équipée d'un lit double avec draps et couette, d'un chauffage individuel, du wifi, d'un dressing ainsi que d'un petit bureau pour travailler ou vous installer confortablement.",
    accent: "stone",
  },
  {
    title: "La terrasse",
    body: "Depuis votre chambre, vous accédez directement à la terrasse, idéale pour savourer vos petits-déjeuners ou profiter du soleil en toute tranquillité lorsque le temps le permet.",
    accent: "forest",
  },
  {
    title: "La salle de bain",
    body: "Vous disposez également d'une salle de bain privative avec douche ainsi que du linge de toilette fourni pour votre confort.",
    accent: "bistre",
  },
];

const defaultSharedCards: ContentCard[] = [
  {
    title: "La cuisine équipée",
    body: "La partie cuisine, accessible de 18h à 20h30, comprend un réfrigérateur, une bouilloire, des plaques chauffantes et un micro-ondes pour chauffer ou réchauffer vos plats.",
    accent: "stone",
  },
  {
    title: "La salle à manger",
    body: "Un espace salle à manger est prévu pour prendre vos petits-déjeuners ou vos repas sur place dans un cadre convivial.",
    accent: "forest",
  },
  {
    title: "Le salon",
    body: "Un coin salon avec téléviseur est également à votre disposition pour vos moments de détente.",
    accent: "bistre",
  },
];

const defaultServiceCards: ContentCard[] = [
  {
    title: "Chauffage individuel",
    body: "La chambre est équipée d'un chauffage individuel pour un confort optimal en toute saison.",
    accent: "forest",
  },
  {
    title: "Parking et local vélo sécurisé",
    body: "Un parking pour voiture ou moto est disponible devant la maison, ainsi qu'un abri sécurisé pouvant accueillir jusqu'à deux vélos.",
    accent: "bistre",
  },
  {
    title: "Connexion wifi",
    body: "Une connexion wifi est disponible pour rester connecté pendant votre séjour.",
    accent: "stone",
  },
];

const rightCardPositions = [
  "lg:col-start-3 lg:row-start-3",
  "lg:col-start-5 lg:row-start-3",
  "lg:col-start-4 lg:row-start-3",
] as const;

const leftCardPositions = [
  "lg:col-start-1 lg:row-start-3",
  "lg:col-start-2 lg:row-start-3",
  "lg:col-start-3 lg:row-start-3",
] as const;

const mobileInterleavedCardOrdersWithHero = [
  "max-lg:order-4 lg:order-none",
  "max-lg:order-6 lg:order-none",
  "max-lg:order-8 lg:order-none",
] as const;
const mobileInterleavedGalleryOrdersWithHero = [
  "max-lg:order-5 lg:order-none",
  "max-lg:order-7 lg:order-none",
  "max-lg:order-9 lg:order-none",
] as const;
const mobileInterleavedCardOrdersNoHero = [
  "max-lg:order-3 lg:order-none",
  "max-lg:order-5 lg:order-none",
  "max-lg:order-7 lg:order-none",
] as const;
const mobileInterleavedGalleryOrdersNoHero = [
  "max-lg:order-4 lg:order-none",
  "max-lg:order-6 lg:order-none",
  "max-lg:order-8 lg:order-none",
] as const;

const galleryColumnStartClasses = {
  1: "lg:col-start-1",
  2: "lg:col-start-2",
  3: "lg:col-start-3",
  4: "lg:col-start-4",
  5: "lg:col-start-5",
} as const;

const hasSanityAsset = (image: RoomPageImageResult | null | undefined) =>
  Boolean(image?.asset && (image.asset._ref || image.asset._id || image.asset.url));

const getSanityDimensions = (image: RoomPageImageResult | null | undefined) =>
  image?.asset?.metadata?.dimensions ?? null;

const getGalleryOrientation = (image: GalleryImage | null): GalleryOrientation => {
  const sanityDimensions = getSanityDimensions(image?.sanityImage);
  const width = sanityDimensions?.width ?? image?.image?.width ?? null;
  const height = sanityDimensions?.height ?? image?.image?.height ?? null;

  return width && height && height > width ? "portrait" : "landscape";
};

const getGalleryColumnSpan = (image: GalleryImage | null) =>
  getGalleryOrientation(image) === "portrait" ? 1 : 2;

const getGalleryColumnStart = (images: GalleryImage[], index: number, startColumn = 1) =>
  images
    .slice(0, index)
    .reduce(
      (column, item) => column + (item.sanityImage || item.image ? getGalleryColumnSpan(item) : 0),
      startColumn
    );
const getGalleryLayoutClasses = (images: GalleryImage[], index: number, startColumn = 1) => {
  const image = images[index] ?? null;
  const orientation = getGalleryOrientation(image);
  const spanClass = orientation === "portrait" ? "lg:col-span-1" : "lg:col-span-2";
  const aspectClass = orientation === "portrait" ? "aspect-[3/4]" : "aspect-[4/3]";
  const columnStart = getGalleryColumnStart(
    images,
    index,
    startColumn
  ) as keyof typeof galleryColumnStartClasses;
  return [
    aspectClass,
    spanClass,
    galleryColumnStartClasses[columnStart] ?? galleryColumnStartClasses[1],
  ];
};
const getGalleryImageDimensions = (image: GalleryImage | null) =>
  getGalleryOrientation(image) === "portrait"
    ? { width: 825, height: 1100 }
    : { width: 1100, height: 825 };

const getGallerySizes = (image: GalleryImage | null) =>
  getGalleryOrientation(image) === "portrait"
    ? "(min-width: 1024px) 20vw, 100vw"
    : "(min-width: 1024px) 40vw, 100vw";

const normalizeCards = (
  sanityCards: RoomPageCardResult[] | null | undefined,
  fallbackCards: ContentCard[]
): ContentCard[] =>
  sanityCards?.length
    ? sanityCards.map((card, index) => {
        const fallback =
          fallbackCards[index] ?? fallbackCards[index % fallbackCards.length] ?? fallbackCards[0];
        return {
          _key: card._key,
          title: card.title ?? fallback.title,
          body: card.body ?? fallback.body,
          accent: card.accent ?? fallback.accent,
        };
      })
    : fallbackCards;

const withSanityImageSources = (
  image: GalleryImage,
  width: number,
  height: number
): GalleryImage => {
  const sanityImage = hasSanityAsset(image.sanityImage) ? image.sanityImage : null;

  return {
    ...image,
    sanityImage,
    sanitySrc: buildSanityImageUrl({
      source: sanityImage,
      width,
      height,
      quality: 80,
      format: "webp",
      fit: "crop",
    }),
    sanitySrcSet: buildSanityDprSrcSet({
      source: sanityImage,
      width,
      height,
      dprs: [1, 1.5, 2],
      quality: 80,
      format: "webp",
      fit: "crop",
    }),
  };
};

const resolveFeatureImage = (
  fallbackImage: ImageMetadata | null,
  fallbackAlt: string,
  sanityImage: RoomPageImageResult | null | undefined,
  loading: "eager" | "lazy"
) => ({
  ...withSanityImageSources(
    {
      image: fallbackImage,
      alt: sanityImage?.alt ?? fallbackAlt,
      sanityImage,
    },
    1400,
    1000
  ),
  loading,
});

const resolveGalleryImages = (
  fallbackImages: GalleryImage[],
  sanityImages: RoomPageImageResult[] | null | undefined
) => {
  const images = sanityImages?.length
    ? sanityImages.map((sanityImage, index) => {
        const fallback =
          fallbackImages[index] ??
          fallbackImages[index % fallbackImages.length] ??
          fallbackImages[0];
        return {
          ...fallback,
          alt: sanityImage.alt ?? fallback.alt,
          sanityImage,
        };
      })
    : fallbackImages;

  return images.map((image) => {
    const dimensions = getGalleryImageDimensions(image);
    return withSanityImageSources(image, dimensions.width, dimensions.height);
  });
};

const getSection = (
  sanitySection: RoomPageSectionResult | null | undefined,
  fallback: {
    eyebrow: string;
    heading: string;
    introText?: string;
    featureImage: GalleryImage;
    cards: ContentCard[];
    galleryImages: GalleryImage[];
  }
) => ({
  eyebrow: sanitySection?.eyebrow ?? fallback.eyebrow,
  heading: sanitySection?.heading ?? fallback.heading,
  introText: sanitySection?.introText ?? fallback.introText ?? null,
  featureImage: resolveFeatureImage(
    fallback.featureImage.image,
    fallback.featureImage.alt,
    sanitySection?.featureImage,
    fallback.eyebrow === "Un séjour tout confort" ? "eager" : "lazy"
  ),
  cards: normalizeCards(sanitySection?.cards, fallback.cards),
  galleryImages: resolveGalleryImages(fallback.galleryImages, sanitySection?.galleryImages),
});

const defaultPrivateGalleryImages: GalleryImage[] = [
  {
    image: room01Image,
    alt: "Chambre lumineuse avec lit double, linge de lit et décoration sobre",
  },
  {
    image: bathroom01Image,
    alt: "Salle de bain privative avec douche et linge de toilette",
  },

  {
    image: terrace01Image,
    alt: "Terrasse en bois accessible directement depuis la chambre",
  },
];

const defaultSharedGalleryImages: GalleryImage[] = [
  {
    image: gardenImage01,
    alt: "Salle à manger lumineuse ouverte sur la terrasse",
  },
  {
    image: cuisineImage,
    alt: "Cuisine équipée avec réfrigérateur, évier, plaques et micro-ondes",
  },
  {
    image: livingroom02Image,
    alt: "Espace salle à manger et salon commun dans une ambiance conviviale",
  },
];

const defaultServiceGalleryImages: GalleryImage[] = [
  {
    image: livingroom03Image,
    alt: "Chambre avec lit double, dressing et rangements",
  },
  {
    image: gardenImage02,
    alt: "Chambre avec lit double, dressing et rangements",
  },
  {
    image: gardenImage03,
    alt: "Accès extérieur pratique depuis la chambre",
  },
];

const p = {
  heroEyebrow: roomPageContent?.heroEyebrow ?? "La chambre",
  heroTitle:
    roomPageContent?.heroTitle ?? "Chambre confortable avec terrasse et accès aux espaces communs",
  privateSection: getSection(roomPageContent?.privateSection, {
    eyebrow: "Un séjour tout confort",
    heading: "Sur place, vous bénéficiez de plusieurs commodités",
    featureImage: {
      image: room02Image,
      alt: "Chambre confortable avec lit double, dressing et espace bureau",
    },
    cards: defaultPrivateCards,
    galleryImages: defaultPrivateGalleryImages,
  }),
  sharedSection: getSection(roomPageContent?.sharedSection, {
    eyebrow: "Espace commun",
    heading: "Des espaces partagés pour vos moments de détente",
    introText:
      "Un espace partagé avec l'hôte (accessible entre 18h et 22h30) qui va vous permettre de profiter de vos soirées chez nous en apportant ou achetant au bourg de quoi vous préparer un repas léger ou votre petit déjeuner.",
    featureImage: {
      image: livingroom01Image,
      alt: "Espace salon partagé pour les moments de détente",
    },
    cards: defaultSharedCards,
    galleryImages: defaultSharedGalleryImages,
  }),
  serviceSection: getSection(roomPageContent?.serviceSection, {
    eyebrow: "Confort au quotidien",
    heading: "Services et équipements",
    featureImage: {
      image: serviceFeatureImage,
      alt: "Espace bureau et rangements de la chambre",
    },
    cards: defaultServiceCards,
    galleryImages: defaultServiceGalleryImages,
  }),
};

const hasServiceFeatureImage = Boolean(
  p.serviceSection.featureImage.sanitySrc || p.serviceSection.featureImage.image
);
---

<BaseLayout>
  <section>
    <div class="relative overflow-x-clip py-[.8rem] lg:pb-[4.8rem] lg:bg-accentStone/25">
      <GridOverlay />
  
      <div
        class="relative z-10 grid grid-cols-1 gap-grid py-[6rem] lg:grid-cols-5 lg:py-[15rem] bg-accentStone/25 lg:bg-transparent"
      >
        <div
          class="col-span-full flex flex-col gap-[3.2rem] px-[0.4rem] lg:col-span-4 lg:col-start-2"
        >
          <span class="heading-3 uppercase">{p.heroEyebrow}</span>
          <h1 class="title-room text-balance">{p.heroTitle}</h1>
        </div>
      </div>
  
      <a
        href="#sejour-confort"
        aria-label="Aller à la section suivante"
        class="absolute bottom-[1.6rem] left-1/2 z-20 -translate-x-1/2 rounded-full p-2 transition-transform hover:translate-y-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-txtPri lg:bottom-[2.4rem]"
      >
        <Icon name="ion/chevron-down-sharp" class="text-txtPri size-[2.4rem]" />
      </a>
    </div>
  </section>

  <section
    id="sejour-confort"
    class="relative overflow-x-clip py-[3.2rem] scroll-mt-[var(--header-height,0px)] lg:py-[4.8rem]"
  >
    <GridOverlay />
    <div class="relative z-10 flex flex-col gap-grid lg:grid lg:grid-cols-5 lg:items-stretch">
      <div
        data-reveal
        data-reveal-delay="0"
        class="max-lg:order-1 px-[0.4rem] pb-[1.6rem] lg:order-none lg:col-span-1 lg:col-start-1 lg:row-start-1 py-[3.2rem] lg:py-[4.8rem]"
      >
        <span class="heading-3">{p.privateSection.eyebrow}</span>
      </div>

      <div
        class="max-lg:order-2 max-w-[72ch] px-[0.4rem] pb-[1.6rem] lg:order-none lg:col-start-3 lg:col-span-3 lg:row-start-2 lg:pb-0 lg:mb-[1.6rem]"
      >
        <div data-reveal data-reveal-delay="80" class="flex flex-col gap-[1.2rem]">
          <h2 class="heading-2 text-balance">{p.privateSection.heading}</h2>
          {
            p.privateSection.introText ? (
              <p class="text-balance text-ui-md leading-relaxed">{p.privateSection.introText}</p>
            ) : null
          }
        </div>
      </div>

      {
        p.privateSection.featureImage.sanitySrc ? (
          <figure
            data-reveal
            data-reveal-delay="120"
            class="max-lg:order-3 group/image relative aspect-[4/3] overflow-hidden bg-accentStone/25 lg:order-none lg:col-span-2 lg:col-start-1 lg:row-span-2 lg:row-start-2 lg:aspect-auto lg:min-h-[24rem]"
          >
            <img
              src={p.privateSection.featureImage.sanitySrc}
              srcset={p.privateSection.featureImage.sanitySrcSet ?? undefined}
              alt={p.privateSection.featureImage.alt}
              width={1400}
              height={1000}
              sizes="(min-width: 1024px) 40vw, 100vw"
              loading="eager"
              decoding="async"
              class="size-full object-cover object-center transition-transform duration-1000 ease-out group-hover/image:scale-[1.03]"
            />
          </figure>
        ) : p.privateSection.featureImage.image ? (
          <figure
            data-reveal
            data-reveal-delay="120"
            class="max-lg:order-3 group/image relative aspect-[4/3] overflow-hidden bg-accentStone/25 lg:order-none lg:col-span-2 lg:col-start-1 lg:row-span-2 lg:row-start-2 lg:aspect-auto lg:min-h-[24rem]"
          >
            <Image
              src={p.privateSection.featureImage.image}
              alt={p.privateSection.featureImage.alt}
              width={1400}
              height={1000}
              densities={[1, 1.5, 2]}
              sizes="(min-width: 1024px) 40vw, 100vw"
              loading="eager"
              decoding="async"
              class="size-full object-cover object-center transition-transform duration-1000 ease-out group-hover/image:scale-[1.03]"
            />
          </figure>
        ) : null
      }

      {
        p.privateSection.cards.map((card, index) => (
          <article
            data-reveal
            data-reveal-delay={String(200 + index * 60)}
            class:list={[
              "flex flex-col gap-[1.2rem] p-[0.8rem] lg:min-h-[11rem] lg:pb-[1.4rem]",
              accentClasses[card.accent],
              mobileInterleavedCardOrdersWithHero[index] ?? mobileInterleavedCardOrdersWithHero[2],
              rightCardPositions[index] ?? rightCardPositions[0],
            ]}
          >
            <div class="border-b border-txtPri/10 pb-[0.8rem]">
              <h3 class="text-ui-lg font-medium leading-snug">{card.title}</h3>
            </div>
            <p class="text-balance text-ui-sm leading-relaxed">{card.body}</p>
          </article>
        ))
      }

      {
        p.privateSection.galleryImages.map((galleryImage, index) =>
          galleryImage.sanitySrc || galleryImage.image ? (
            <figure
              data-reveal
              data-reveal-delay={String(380 + index * 50)}
              class:list={[
                "group/image relative overflow-hidden bg-accentStone/25 lg:row-start-4",
                mobileInterleavedGalleryOrdersWithHero[index] ??
                  mobileInterleavedGalleryOrdersWithHero[2],
                ...getGalleryLayoutClasses(p.privateSection.galleryImages, index),
              ]}
            >
              {galleryImage.sanitySrc ? (
                <img
                  src={galleryImage.sanitySrc}
                  srcset={galleryImage.sanitySrcSet ?? undefined}
                  alt={galleryImage.alt}
                  width={getGalleryImageDimensions(galleryImage).width}
                  height={getGalleryImageDimensions(galleryImage).height}
                  sizes={getGallerySizes(galleryImage)}
                  loading="lazy"
                  decoding="async"
                  class="size-full object-cover object-center transition-transform duration-1000 ease-out group-hover/image:scale-[1.03]"
                />
              ) : galleryImage.image ? (
                <Image
                  src={galleryImage.image}
                  alt={galleryImage.alt}
                  width={getGalleryImageDimensions(galleryImage).width}
                  height={getGalleryImageDimensions(galleryImage).height}
                  densities={[1, 1.5, 2]}
                  sizes={getGallerySizes(galleryImage)}
                  loading="lazy"
                  decoding="async"
                  class="size-full object-cover object-center transition-transform duration-1000 ease-out group-hover/image:scale-[1.03]"
                />
              ) : null}
            </figure>
          ) : null
        )
      }
    </div>
  </section>

  <section class="relative overflow-x-clip py-[3.2rem] lg:py-[4.8rem]">
    <GridOverlay />

    <div class="relative z-10 flex flex-col gap-grid lg:grid lg:grid-cols-5 lg:items-stretch">
      <div
        data-reveal
        data-reveal-delay="0"
        class="max-lg:order-1 px-[0.4rem] pb-[1.6rem] lg:order-none lg:col-span-1 lg:col-start-1 lg:row-start-1 py-[3.2rem] lg:py-[4.8rem]"
      >
        <span class="heading-3">{p.sharedSection.eyebrow}</span>
      </div>

      <div
        class="max-lg:order-2 flex flex-col pb-[1.6rem] lg:order-none lg:col-span-3 lg:col-start-1 lg:row-start-2 lg:pb-0"
      >
        <div data-reveal data-reveal-delay="80" class="flex flex-col gap-[1.2rem] pb-[1.6rem]">
          <h2 class="heading-2 text-balance leading-[1.2] min-h-[2.4em]">
            {p.sharedSection.heading}
          </h2>
          {
            p.sharedSection.introText ? (
              <p class="text-balance text-ui-md leading-relaxed">{p.sharedSection.introText}</p>
            ) : null
          }
        </div>
      </div>

      {
        p.sharedSection.cards.map((card, index) => (
          <article
            data-reveal
            data-reveal-delay={String(180 + index * 60)}
            class:list={[
              "flex flex-col gap-[1.2rem] p-[0.8rem] lg:min-h-[13rem] lg:pb-[1.4rem]",
              accentClasses[card.accent],
              mobileInterleavedCardOrdersWithHero[index] ?? mobileInterleavedCardOrdersWithHero[2],
              leftCardPositions[index] ?? leftCardPositions[0],
            ]}
          >
            <div class="border-b border-txtPri/10 pb-[0.8rem]">
              <h3 class="text-ui-lg font-medium leading-snug">{card.title}</h3>
            </div>
            <p class="text-balance text-ui-sm leading-relaxed">{card.body}</p>
          </article>
        ))
      }

      {
        p.sharedSection.featureImage.sanitySrc ? (
          <figure
            data-reveal
            data-reveal-delay="360"
            class="max-lg:order-3 group/image relative aspect-[3/4] lg:aspect-[4/3] overflow-hidden bg-accentStone/25 lg:order-none lg:col-span-2 lg:col-start-4 lg:row-span-2 lg:row-start-2 lg:aspect-auto lg:min-h-[24rem]"
          >
            <img
              src={p.sharedSection.featureImage.sanitySrc}
              srcset={p.sharedSection.featureImage.sanitySrcSet ?? undefined}
              alt={p.sharedSection.featureImage.alt}
              width={1400}
              height={1000}
              sizes="(min-width: 1024px) 40vw, 100vw"
              loading="lazy"
              decoding="async"
              class="size-full object-cover object-center transition-transform duration-1000 ease-out group-hover/image:scale-[1.03]"
            />
          </figure>
        ) : p.sharedSection.featureImage.image ? (
          <figure
            data-reveal
            data-reveal-delay="360"
            class="max-lg:order-3 group/image relative aspect-[3/4] lg:aspect-[4/3] overflow-hidden bg-accentStone/25 lg:order-none lg:col-span-2 lg:col-start-4 lg:row-span-2 lg:row-start-2 lg:aspect-auto lg:min-h-[24rem]"
          >
            <Image
              src={p.sharedSection.featureImage.image}
              alt={p.sharedSection.featureImage.alt}
              width={1400}
              height={1000}
              densities={[1, 1.5, 2]}
              sizes="(min-width: 1024px) 40vw, 100vw"
              loading="lazy"
              decoding="async"
              class="size-full object-cover object-center transition-transform duration-1000 ease-out group-hover/image:scale-[1.03]"
            />
          </figure>
        ) : null
      }

      {
        p.sharedSection.galleryImages.map((galleryImage, index) =>
          galleryImage.sanitySrc || galleryImage.image ? (
            <figure
              data-reveal
              data-reveal-delay={String(420 + index * 50)}
              class:list={[
                "group/image relative overflow-hidden bg-accentStone/25 lg:row-start-4",
                mobileInterleavedGalleryOrdersWithHero[index] ??
                  mobileInterleavedGalleryOrdersWithHero[2],
                ...getGalleryLayoutClasses(p.sharedSection.galleryImages, index),
              ]}
            >
              {galleryImage.sanitySrc ? (
                <img
                  src={galleryImage.sanitySrc}
                  srcset={galleryImage.sanitySrcSet ?? undefined}
                  alt={galleryImage.alt}
                  width={getGalleryImageDimensions(galleryImage).width}
                  height={getGalleryImageDimensions(galleryImage).height}
                  sizes={getGallerySizes(galleryImage)}
                  loading="lazy"
                  decoding="async"
                  class="size-full object-cover object-center transition-transform duration-1000 ease-out group-hover/image:scale-[1.03]"
                />
              ) : galleryImage.image ? (
                <Image
                  src={galleryImage.image}
                  alt={galleryImage.alt}
                  width={getGalleryImageDimensions(galleryImage).width}
                  height={getGalleryImageDimensions(galleryImage).height}
                  densities={[1, 1.5, 2]}
                  sizes={getGallerySizes(galleryImage)}
                  loading="lazy"
                  decoding="async"
                  class="size-full object-cover object-center transition-transform duration-1000 ease-out group-hover/image:scale-[1.03]"
                />
              ) : null}
            </figure>
          ) : null
        )
      }
    </div>
  </section>

  <section class="relative overflow-x-clip py-[3.2rem] lg:py-[4.8rem]">
    <GridOverlay />

    <div class="relative z-10 flex flex-col gap-grid lg:grid lg:grid-cols-5 lg:items-stretch">
      <div
        data-reveal
        data-reveal-delay="0"
        class="max-lg:order-1 px-[0.4rem] pb-[1.6rem] lg:order-none lg:col-span-1 lg:col-start-1 lg:row-start-1 py-[3.2rem] lg:py-[4.8rem]"
      >
        <span class="heading-3">{p.serviceSection.eyebrow}</span>
      </div>

      <div
        class="max-lg:order-2 max-w-[72ch] px-[0.4rem] pb-[1.6rem] lg:order-none lg:col-start-1 lg:col-span-2 lg:row-start-3 lg:pb-0"
      >
        <div data-reveal data-reveal-delay="80" class="flex flex-col gap-[1.2rem]">
          <h2 class="heading-2 text-balance">{p.serviceSection.heading}</h2>
          {
            p.serviceSection.introText ? (
              <p class="text-balance text-ui-md leading-relaxed">{p.serviceSection.introText}</p>
            ) : null
          }
        </div>
      </div>

      {
        p.serviceSection.featureImage.sanitySrc ? (
          <figure
            data-reveal
            data-reveal-delay="120"
            class="max-lg:order-3 group/image relative aspect-[4/3] overflow-hidden bg-accentStone/25 lg:order-none lg:col-span-2 lg:col-start-1 lg:row-span-2 lg:row-start-2 lg:aspect-auto lg:min-h-[24rem]"
          >
            <img
              src={p.serviceSection.featureImage.sanitySrc}
              srcset={p.serviceSection.featureImage.sanitySrcSet ?? undefined}
              alt={p.serviceSection.featureImage.alt}
              width={1400}
              height={1000}
              sizes="(min-width: 1024px) 40vw, 100vw"
              loading="lazy"
              decoding="async"
              class="size-full object-cover object-center transition-transform duration-1000 ease-out group-hover/image:scale-[1.03]"
            />
          </figure>
        ) : p.serviceSection.featureImage.image ? (
          <figure
            data-reveal
            data-reveal-delay="120"
            class="max-lg:order-3 group/image relative aspect-[4/3] overflow-hidden bg-accentStone/25 lg:order-none lg:col-span-2 lg:col-start-1 lg:row-span-2 lg:row-start-2 lg:aspect-auto lg:min-h-[24rem]"
          >
            <Image
              src={p.serviceSection.featureImage.image}
              alt={p.serviceSection.featureImage.alt}
              width={1400}
              height={1000}
              densities={[1, 1.5, 2]}
              sizes="(min-width: 1024px) 40vw, 100vw"
              loading="lazy"
              decoding="async"
              class="size-full object-cover object-center transition-transform duration-1000 ease-out group-hover/image:scale-[1.03]"
            />
          </figure>
        ) : null
      }

      {
        p.serviceSection.cards.map((card, index) => (
          <article
            data-reveal
            data-reveal-delay={String(200 + index * 60)}
            class:list={[
              "flex flex-col gap-[1.2rem] p-[0.8rem] lg:min-h-[11rem] lg:pb-[1.4rem]",
              accentClasses[card.accent],
              ...(hasServiceFeatureImage
                ? [
                    mobileInterleavedCardOrdersWithHero[index] ??
                      mobileInterleavedCardOrdersWithHero[2],
                  ]
                : [
                    mobileInterleavedCardOrdersNoHero[index] ??
                      mobileInterleavedCardOrdersNoHero[2],
                  ]),
              rightCardPositions[index] ?? rightCardPositions[0],
            ]}
          >
            <div class="border-b border-txtPri/10 pb-[0.8rem]">
              <h3 class="text-ui-lg font-medium leading-snug">{card.title}</h3>
            </div>
            <p class="text-balance text-ui-sm leading-relaxed">{card.body}</p>
          </article>
        ))
      }

      {
        p.serviceSection.galleryImages.map((galleryImage, index) =>
          galleryImage.sanitySrc || galleryImage.image ? (
            <figure
              data-reveal
              data-reveal-delay={String(380 + index * 50)}
              class:list={[
                "group/image relative overflow-hidden bg-accentStone/25 lg:row-start-4",
                ...(hasServiceFeatureImage
                  ? [
                      mobileInterleavedGalleryOrdersWithHero[index] ??
                        mobileInterleavedGalleryOrdersWithHero[2],
                    ]
                  : [
                      mobileInterleavedGalleryOrdersNoHero[index] ??
                        mobileInterleavedGalleryOrdersNoHero[2],
                    ]),
                ...getGalleryLayoutClasses(p.serviceSection.galleryImages, index, 1),
              ]}
            >
              {galleryImage.sanitySrc ? (
                <img
                  src={galleryImage.sanitySrc}
                  srcset={galleryImage.sanitySrcSet ?? undefined}
                  alt={galleryImage.alt}
                  width={getGalleryImageDimensions(galleryImage).width}
                  height={getGalleryImageDimensions(galleryImage).height}
                  sizes={getGallerySizes(galleryImage)}
                  loading="lazy"
                  decoding="async"
                  class="size-full object-cover object-center transition-transform duration-1000 ease-out group-hover/image:scale-[1.03]"
                />
              ) : galleryImage.image ? (
                <Image
                  src={galleryImage.image}
                  alt={galleryImage.alt}
                  width={getGalleryImageDimensions(galleryImage).width}
                  height={getGalleryImageDimensions(galleryImage).height}
                  densities={[1, 1.5, 2]}
                  sizes={getGallerySizes(galleryImage)}
                  loading="lazy"
                  decoding="async"
                  class="size-full object-cover object-center transition-transform duration-1000 ease-out group-hover/image:scale-[1.03]"
                />
              ) : null}
            </figure>
          ) : null
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .title-room {
    font-size: clamp(32px, calc(32 * 1px + (52) * (100vw - 375 * 1px) / (1225)), 68px);
    line-height: 1;
  }
</style>

<script>
  const elements = document.querySelectorAll<HTMLElement>("[data-reveal]");

  elements.forEach((el) => {
    const delay = el.dataset.revealDelay ?? "0";
    el.style.setProperty("--reveal-delay", `${delay}ms`);
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        requestAnimationFrame(() => {
          (entry.target as HTMLElement).classList.add("is-visible");
        });
        observer.unobserve(entry.target);
      });
    },
    { threshold: 0.1 }
  );

  elements.forEach((el) => observer.observe(el));
</script>
