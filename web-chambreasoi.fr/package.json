{
  "name": "web-chambreasoi-fr",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "build:ci": "ENABLE_SANITY_STUDIO=false astro build",
    "deploy": "ENABLE_SANITY_STUDIO=true astro build && wrangler deploy",
    "deploy:preview": "ENABLE_SANITY_STUDIO=true astro build && wrangler versions upload",
    "format": "biome format --write . && prettier --write \"**/*.astro\"",
    "format:astro": "prettier --write \"**/*.astro\"",
    "format:check": "biome format . && prettier --check \"**/*.astro\"",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.4",
    "@astrojs/react": "^5.0.2",
    "@chambreasoi/sanity": "workspace:*",
    "@sanity/astro": "^3.3.1",
    "@sanity/client": "^7.20.0",
    "@sanity/vision": "^5.18.0",
    "@unocss/reset": "^66.6.7",
    "astro": "^6.1.1",
    "astro-icon": "^1.1.5",
    "astro-seo-schema": "^6.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^5.18.0",
    "schema-dts": "^2.0.0",
    "sharp": "^0.34.5",
    "styled-components": "^6.3.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/node": "^10.0.4",
    "@biomejs/biome": "^2.4.9",
    "@cloudflare/workers-types": "^4.20260329.1",
    "@types/react": "^19.2.14",
    "@unocss/astro": "^66.6.7",
    "@unocss/preset-web-fonts": "^66.6.7",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.2",
    "unocss": "^66.6.7",
    "wrangler": "4.78.0"
  }
}
