{
  "name": "web-chambreasoi-fr",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "build:ci": "ENABLE_SANITY_STUDIO=false astro build",
    "deploy": "astro build && wrangler deploy",
    "deploy:preview": "astro build && wrangler versions upload",
    "format": "biome format --write . && prettier --write \"**/*.astro\"",
    "format:astro": "prettier --write \"**/*.astro\"",
    "format:check": "biome format . && prettier --check \"**/*.astro\"",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/react": "^5.0.7",
    "@astrojs/sitemap": "^3.7.4",
    "@chambreasoi/sanity": "workspace:*",
    "@sanity/astro": "^3.6.0",
    "@sanity/client": "^7.28.0",
    "@unocss/reset": "^66.12.0",
    "astro": "^6.4.8",
    "astro-icon": "^1.2.0",
    "astro-leaflet": "^1.12.0",
    "astro-seo-schema": "^6.0.0",
    "leaflet-extra-markers": "^2.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^5.31.2",
    "schema-dts": "^2.1.0",
    "sharp": "^0.34.5",
    "styled-components": "^6.6.0",
    "vanilla-calendar-pro": "~3.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/node": "^10.1.4",
    "@biomejs/biome": "~2.6.5",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/react": "^19.3.0",
    "@unocss/astro": "^66.12.0",
    "@unocss/preset-web-fonts": "^66.12.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "unocss": "^66.12.0",
    "vitest": "^4.1.12",
    "wrangler": "4.107.1",
    "zod": "^4.6.7"
  }
}
