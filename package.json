{
  "name": "chambreasoi-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "9.x"
  },
  "pnpm": {
    "overrides": {
      "tar": "7.5.11",
      "undici": "7.24.0",
      "prismjs": "1.30.0",
      "lodash": "4.18.0",
      "js-yaml@<3.14.2": ">=3.14.2",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "follow-redirects@<=1.15.11": ">=1.16.0",
      "uuid@<11.1.1": ">=11.1.1"
    }
  },
  "scripts": {
    "dev:web": "pnpm --filter web-chambreasoi-fr dev",
    "dev:studio": "pnpm --filter chambreasoifr dev",
    "build:web": "pnpm --filter web-chambreasoi-fr build",
    "build:studio": "pnpm --filter chambreasoifr build",
    "deploy:web": "pnpm --filter web-chambreasoi-fr deploy",
    "install:all": "pnpm install",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "pnpm --filter web-chambreasoi-fr test && pnpm --filter @chambreasoi/sanity test && pnpm --filter chambreasoifr typecheck",
    "ci:verify": "pnpm test && pnpm typecheck"
  }
}
