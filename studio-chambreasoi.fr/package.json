{
  "name": "studio-chambreasoi-fr",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build && cp static/robots.txt static/_redirects dist/",
    "deploy": "pnpm run build && wrangler pages deploy dist --project-name=chambreasoi-studio --branch=main --commit-dirty=true",
    "deploy:preview": "pnpm run build && wrangler pages deploy dist --project-name=chambreasoi-studio --branch=develop --commit-dirty=true",
    "deploy:sanity-hosted": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/icons": "^3.8.0",
    "@sanity/vision": "^5.31.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^5.31.2",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "wrangler": "4.107.1"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
}
